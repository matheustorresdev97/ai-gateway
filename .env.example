# =====================================================================
#  MODELO do .env. Copie com:  cp .env.example .env  e preencha o .env
#  (o .env fica fora do Git; este arquivo vai para o repositório SEM chaves).
#  Formato: NOME=valor (sem espaços ao redor do "=").
#  ⚠️ Não compartilhe este arquivo com as chaves preenchidas.
#
#  Preencha pelo menos UM provedor (ChatGPT ou Gemini). Com os dois, os
#  exemplos de gateway usam os dois. Deixe "COLE_..." no que não for usar.
# =====================================================================

# --- ChatGPT (OpenAI) ---  chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=COLE_SUA_CHAVE_OPENAI_AQUI
MODELO_OPENAI=COLE_O_MODELO_OPENAI_AQUI

# --- Gemini (Google AI Studio) ---  chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=COLE_SUA_CHAVE_GEMINI_AQUI
MODELO_GEMINI=COLE_O_MODELO_GEMINI_AQUI

# --- Chave mestra do LiteLLM Proxy (pastas 04 a 07) ---
# Você inventa. Precisa começar com "sk-". É a chave do ADMIN do gateway.
LITELLM_MASTER_KEY=sk-mestre-troque-isto
